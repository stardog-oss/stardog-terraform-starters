# Expected to be set as environment variables
#
# export TF_VAR_jfrog_registry_username=<USERNAME>
# export TF_VAR_jfrog_registry_password=<PASSWORD>
# export TF_VAR_stardog_license_base64="$(base64 < stardog-license-key.bin | tr -d '\n')"

subscription_id      = "<azure-subscription-id>"
resource_group_name  = "<aks-resource-group>"
aks_name             = "<aks-cluster-name>"
acr_name             = "<shared-or-existing-acr-name>"
ingress_dns_root     = "stardog.example.com"

stardog_namespace    = "stardog"
stardog_release      = "stardog"
deploy_stardog_stack = true

stardog_chart_url    = "oci://<internal-or-public-registry>/charts/stardog"
stardog_chart_version = "<chart-version>"
stardog_image_tag    = "<stardog-image-tag>"

launchpad_enabled    = true
launchpad_image_tag  = "<launchpad-image-tag>"
voicebox_image_tag   = "<voicebox-image-tag>"

images_to_import = [
  "stardog/stardog:<version>",
  "stardog/launchpad:<version>",
]

charts_to_import = [
  "oci://<internal-or-public-registry>/charts/stardog:<version>",
]
