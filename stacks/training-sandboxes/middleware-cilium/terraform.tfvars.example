subscription_id = "<azure-subscription-id>"
tenant_id       = "<azure-tenant-id>"
name_prefix     = "training"

# Terraform state for infra (same storage account as infra)
tfstate_resource_group_name  = "<tfstate-resource-group>"
tfstate_storage_account_name = "<tfstate-storage-account>"

# Cilium Gateway API middleware
enable_gateway_install = true

# Optional: limit which students are upgraded
# target_students = ["sd1", "sd2"]

# Optional: override the existing Cilium release location
# cilium_namespace    = "kube-system"
# cilium_release_name = "cilium"
